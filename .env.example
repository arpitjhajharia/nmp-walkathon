# Copy to .env.local for local development. On Vercel, add the same values under
# Project → Settings → Environment Variables (the Vercel ↔ Supabase integration adds
# the first three for you).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only secret. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Demo mode shows one-click demo sign-ins and "Reset demo data". Use it only with demo data.
DEMO_MODE=false

# Limit admin sign-in to this email domain. People you add don't sign in, so their email
# addresses aren't restricted.
# ALLOWED_EMAIL_DOMAIN=yourcompany.com

# Used once by `npm run setup` to create your admin account. Remove the password afterwards.
# ADMIN_EMAIL=wellness@yourcompany.com
# ADMIN_PASSWORD=change-me-now
# ADMIN_NAME=Walkathon Admin

# Daily steps are read from this Google Sheet (see docs/google-sheet.md).
# The id is the long part of the sheet's web address, and it must be shared as
# "Anyone with the link can view".
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Data

# Protects the scheduled sync at /api/cron/sheet-sync. Vercel sends it automatically
# when this is set; generate one with: openssl rand -hex 24
# CRON_SECRET=
