# Copy to .env.local and adjust.

# Demo mode seeds four sample teams and shows quick sign-in buttons and "Reset demo data".
# Defaults to true in development and false in production.
DEMO_MODE=true

# Where the SQLite database lives. Keep it OUTSIDE OneDrive/Dropbox/iCloud folders in production.
# DATABASE_PATH=/var/lib/walkathon/walkathon.db

# First admin account, created only when the database is empty and DEMO_MODE=false.
# ADMIN_EMAIL=wellness@yourcompany.com
# ADMIN_PASSWORD=change-me-now
# ADMIN_NAME=Walkathon Admin

# Only allow sign-in (and new members) with this email domain.
# ALLOWED_EMAIL_DOMAIN=yourcompany.com

# Optional Google Sheets backup via an Apps Script web app (see docs/google-sheets.md).
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
# GOOGLE_SHEETS_SECRET=a-long-random-string

# Testing only: pretend today is this date (YYYY-MM-DD) in the season timezone.
# WALKATHON_TODAY=2026-10-30
